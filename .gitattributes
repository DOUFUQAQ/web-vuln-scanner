* text=auto

# 文本文件统一按 LF 入库（工作区检出任一平台都能用）
*.py      text eol=lf
*.md      text eol=lf
*.txt     text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.json    text eol=lf
*.ts      text eol=lf
*.tsx     text eol=lf
*.css     text eol=lf
*.html    text eol=lf
*.js      text eol=lf

# 二进制
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
