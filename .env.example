# 复制成 .env 后按需修改；backend/app.py 会自动加载（需要 python-dotenv）。
# 全部项都有代码内默认值，不配置也能在本地跑起来。

# ---------- Flask ----------
# 会话签名密钥。默认值是代码里的占位串，启动时会打印告警。
# 生成一个：python -c "import secrets; print(secrets.token_hex(32))"
SCANNER_SECRET_KEY=change-me-please

# 数据库连接串。默认 sqlite:///vulnerability_scanner.db（落在启动目录）
DATABASE_URL=sqlite:///vulnerability_scanner.db

# CORS 允许的来源，'*' 表示全放开（仅适合本地开发）
SCANNER_CORS_ORIGINS=*

# 监听地址与端口。默认只听 127.0.0.1，改成 0.0.0.0 才会对局域网开放
SCANNER_HOST=127.0.0.1
SCANNER_PORT=5000

# 调试模式（默认关闭；打开会暴露 Werkzeug 调试器，别在公网开）
SCANNER_DEBUG=false

# ---------- 扫描器 ----------
# 单次 HTTP 请求超时（秒）
SCANNER_HTTP_TIMEOUT=10

# 是否校验目标站点的 TLS 证书。默认 false（靶场常用自签证书），
# 打开会牺牲对自签站点的兼容性，但能防中间人。
SCANNER_TLS_VERIFY=false

# 是否拦截指向本机 / 私网 / 云元数据地址的目标。
# 默认 false，因为靶场跑在 localhost。多人共享部署时请设 true。
SCANNER_BLOCK_PRIVATE_TARGETS=false

# 主机白名单（逗号分隔，支持 *.example.com 形式）。留空表示不限制。
SCANNER_ALLOWED_TARGET_HOSTS=
